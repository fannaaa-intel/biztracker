<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>BizTracker</RootNamespace>
    <StartupObject>Sub Main</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- HTML templates for printable documents (ReportService reads them next to the .exe) -->
    <None Update="Templates\**\*.html" CopyToOutputDirectory="PreserveNewest" />
    <!-- Gmail settings for Forgot Password (NOT in Git, see docs/EMAIL_SETUP.md); copied only if it exists -->
    <None Update="email-settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="MySql.Data" Version="26.7.0" />
  </ItemGroup>

</Project>